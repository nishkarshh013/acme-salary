#!/bin/bash -e

# Enable jemalloc for reduced memory usage and latency.
if [ -z "${LD_PRELOAD+x}" ]; then
    LD_PRELOAD=$(find /usr/lib -name libjemalloc.so.2 -print -quit)
    export LD_PRELOAD
fi

# Railway says which port to listen on in PORT (3000 when unset). Thruster
# listens there (HTTP_PORT) and runs Puma behind it on TARGET_PORT, setting
# Puma's PORT to that itself.
export HTTP_PORT="${PORT:-3000}"
export TARGET_PORT="${TARGET_PORT:-3100}"

# When starting the server: create or migrate the database, then seed it.
# Seeding is safe on every start: it creates the HR manager account only if
# missing (HR_EMAIL and HR_PASSWORD are required) and generates demo data
# only into an empty database.
if [ "${@: -2:1}" == "./bin/rails" ] && [ "${@: -1:1}" == "server" ]; then
  ./bin/rails db:prepare
  ./bin/rails db:seed
fi

exec "${@}"
