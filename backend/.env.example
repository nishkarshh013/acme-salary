# Environment variables the backend reads. Copy the ones you need into your
# shell or your host's settings; nothing loads this file automatically.

# Time zone that decides what "today" is (default: UTC). Effective dates and
# hire dates can't be later than today in this zone, and the frontend's date
# pickers use the same date (from GET /api/session). Use a name from
# `bin/rails time:zones:all`, e.g. Asia/Kolkata or Europe/Berlin.
APP_TIME_ZONE=UTC

# The HR Manager account created by `bin/rails db:seed`. Required outside
# development; development falls back to demo credentials. Never commit real values.
HR_EMAIL=
HR_PASSWORD=
